import { INITIAL_MAX_DEPTH, LOGICAL_WIDTH, SURFACE_Y } from "./constants";
import { FISH_KINDS } from "./fish-data";
import { loadSave } from "./storage";
import { rand } from "./math";
import type { Fish, GameState, GameMode, NetState, PlayerStats, Upgrades } from "./types";

let idCounter = 1;
const nextId = () => idCounter++;

function reachableSpawnDepth(maxDepth: number) {
  return Math.min(820 - 8, maxDepth + 90);
}

function depthForKind(kind: (typeof FISH_KINDS)[number], maxDepth: number) {
  const lo = kind.depthMin;
  const hi = Math.min(kind.depthMax, reachableSpawnDepth(maxDepth), 820 - 8);
  return hi <= lo ? lo : rand(lo, hi);
}

function makeFish(maxDepth: number): Fish {
  const kinds = FISH_KINDS.filter((k) => k.depthMin <= reachableSpawnDepth(maxDepth));
  const chosen = kinds.length > 0 ? kinds : FISH_KINDS.slice(0, 1);
  const total = chosen.reduce((a, k) => a + k.rarity, 0);
  let r = Math.random() * total;
  let kind = chosen[0];
  for (const k of chosen) {
    r -= k.rarity;
    if (r <= 0) {
      kind = k;
      break;
    }
  }
  const dir = Math.random() < 0.5 ? -1 : 1;
  return {
    id: nextId(),
    kind,
    x: dir < 0 ? LOGICAL_WIDTH + rand(10, 80) : -rand(10, 80),
    y: depthForKind(kind, maxDepth),
    vx: dir * kind.speed * rand(0.8, 1.2),
    size: kind.size,
    caught: false,
    wobble: Math.random() * Math.PI * 2,
    flash: 0,
  };
}

export function createInitialState(): GameState {
  const save = loadSave();
  const stats: PlayerStats = {
    money: 0,
    bestMoney: save.bestMoney,
    maxDepth: INITIAL_MAX_DEPTH,
    netSize: 22,
    pullSpeed: 220,
    dropSpeed: 240,
    capacity: 3,
  };
  const fish: Fish[] = [];
  for (let i = 0; i < 14; i++) {
    const f = makeFish(stats.maxDepth);
    f.x = rand(20, LOGICAL_WIDTH - 20);
    fish.push(f);
  }
  return {
    mode: "start" as GameMode,
    net: { x: LOGICAL_WIDTH / 2, y: SURFACE_Y, state: "idle" as NetState, tension: 0, pulse: 0 },
    stats,
    upgrades: { depth: 0, netSize: 0, pullSpeed: 0, capacity: 0 } as Upgrades,
    fish,
    carrying: [] as Fish[],
    feedback: [],
    ripples: [],
    lastCatchValue: 0,
    lastSummary: null,
    shake: 0,
  } satisfies GameState;
}
</file>

<file path="app/components/bat-ca/game/economySystem.ts">
import { SURFACE_Y } from "./constants";
import { saveBest } from "./storage";
import type { CaughtSummary, Fish, PlayerStats, UpgradeType, Upgrades } from "./types";
import type { UpgradeDef } from "./upgrades";
import { upgradeCost } from "./upgrades";

export function buyUpgrade(
  type: UpgradeType,
  stats: PlayerStats,
  upgrades: Upgrades,
  defs: UpgradeDef[],
) {
  const def = defs.find((d) => d.type === type)!;
  const lvl = upgrades[type];
  const cost = upgradeCost(def, lvl);
  if (cost === null) return false;
  if (stats.money < cost) return false;
  stats.money -= cost;
  upgrades[type] = lvl + 1;
  def.apply(stats);
  return true;
}

export function sellCatch(
  carrying: Fish[],
  stats: PlayerStats,
  netX: number,
  addFeedback: (x: number, y: number, text: string, color: string) => void,
  addRipple: (x: number, y: number, r?: number, life?: number) => void,
  triggerShake: (amount: number) => void,
) {
  let total = 0;
  let badCount = 0;
  const items = carrying.map((f) => {
    total += f.kind.value;
    if (f.kind.isBad) badCount++;
    return { name: f.kind.name, value: f.kind.value, isBad: f.kind.isBad };
  });
  total = Math.max(0, total);
  stats.money += total;
  if (total > 0) addFeedback(netX, SURFACE_Y - 6, `+${total}đ`, "#e87432");
  if (stats.money > stats.bestMoney) {
    stats.bestMoney = stats.money;
    saveBest(stats.bestMoney);
  }
  const summary: CaughtSummary = { count: items.length, earned: total, badCount, items };
  addRipple(netX, SURFACE_Y, 12, 0.9);
  if (total >= 100) triggerShake(0.65);
  carrying.length = 0;
  return summary;
}
