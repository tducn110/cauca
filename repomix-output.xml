  --dock-waterline-y: 328px;
  --dock-gauge-center-y: 421px;
  --dock-gauge-size: 108px;
  --dock-upgrade-top: 486px;
  --dock-safe-top: 25px;
  --dock-safe-right: 20px;
  --dock-safe-bottom: 18px;
  --dock-safe-left: 20px;
  --dock-viewport-inset-top: env(safe-area-inset-top, 0px);
  --dock-viewport-inset-right: env(safe-area-inset-right, 0px);
  --dock-viewport-inset-bottom: env(safe-area-inset-bottom, 0px);
  --dock-viewport-inset-left: env(safe-area-inset-left, 0px);

  position: fixed;
  inset: 0;
  min-width: 320px;
  min-height: 100vh;
  min-height: 100dvh;
  overflow: hidden;
  isolation: isolate;
  background: #052c62;
  color: #30274f;
  font-family: "Be Vietnam Pro", system-ui, sans-serif;
}

.fishing-dock-screen::after {
  position: absolute;
  z-index: 25;
  inset: 0;
  background: #fff;
  content: "";
  opacity: 0;
  pointer-events: none;
}

.fishing-dock-screen.is-launching::after {
  animation: dock-launch-flash 720ms ease-in both;
}

@keyframes dock-launch-flash {
  0%, 46% { opacity: 0; }
  68% { opacity: 0.3; }
  100% { opacity: 1; }
}

.fishing-dock-screen__notice,
.fishing-dock-screen__power-result {
  position: absolute;
  z-index: 42;
  left: 50%;
  transform: translateX(-50%);
