/* Global App Styles */
html { scroll-behavior: smooth; }
body { margin: 0; }
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: var(--paper-warm, #efe3c4); }
::-webkit-scrollbar-thumb { background: #c8bfa6; border-radius: 999px; }
::-webkit-scrollbar-thumb:hover { background: var(--pencil-gray, #a89c80); }

/* Landing page entrance animation */
.landing-enter {
  animation: landingReveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@keyframes landingReveal {
  0% { opacity: 0; transform: translateY(24px) scale(0.97); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* Hero animations */
.hero-badge {
  animation: heroSlideUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
}
.hero-title {
  animation: heroSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
}
.hero-desc {
  animation: heroSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
}
.hero-cta {
  animation: heroCTAPop 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
}

@keyframes heroSlideUp {
  0% { opacity: 0; transform: translateY(36px); filter: blur(4px); }
  100% { opacity: 1; transform: translateY(0); filter: blur(0); }
}

@keyframes heroCTAPop {
  0% { opacity: 0; transform: translateY(28px) scale(0.85); }
  60% { opacity: 1; transform: translateY(-4px) scale(1.03); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* Landing hero responsive composition */
@media (max-width: 640px) {
  .hero-section {
    min-height: 100svh !important;
    padding-top: 64px !important;
    place-items: start center !important;
  }

  .hero-content {
    width: min(100%, 390px) !important;
    padding: 100px 22px 0 !important;
    gap: 18px !important;
  }

  .hero-badge {
    font-size: 11px !important;
    letter-spacing: 1.2px !important;
    padding: 6px 14px !important;
