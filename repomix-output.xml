.fishing-dock-canvas {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background: #052c62;
}

.fishing-dock-canvas__element {
  position: absolute;
  z-index: 2;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.fishing-dock-canvas__fallback {
  position: absolute;
  z-index: 1;
  inset: 0;
  overflow: hidden;
  opacity: 1;
  pointer-events: none;
  transition: opacity 180ms ease;
}

.fishing-dock-canvas.is-scene-ready .fishing-dock-canvas__fallback {
  visibility: hidden;
  opacity: 0;
}

.fishing-dock-canvas__background {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
}

.fishing-dock-canvas__water {
  position: absolute;
  z-index: 2;
  top: var(--dock-waterline-y, 328px);
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  background:
    linear-gradient(180deg, #249ce7, #1a7ad8 4%, #176fca 10%, #0f5cb8 22%, #0a4a9a 40%, #073a7c 65%, #052c62 100%);
}

.fishing-dock-canvas__channel {
  position: absolute;
  top: -4px;
  bottom: -12px;
  left: calc(var(--dock-gameplay-axis-x, 640px) - var(--dock-channel-width, 371px) / 2);
  width: var(--dock-channel-width, 371px);
  border-radius: 42% 46% 31% 37% / 12% 14% 6% 8%;
  background:
    linear-gradient(180deg, rgba(48, 174, 255, 0.12), rgba(31, 124, 231, 0.06));
  clip-path: polygon(29% 0, 71% 0, 86% 100%, 14% 100%);
}

.fishing-dock-canvas__rear-wave,
.fishing-dock-canvas__front-wave {
  position: absolute;
  right: -3%;
  left: -3%;
  height: 18px;
  background: radial-gradient(28px 11px at 50% 0, transparent 66%, currentColor 70% 81%, transparent 85%) 0 0 / 56px 18px repeat-x;
  color: rgba(210, 250, 255, 0.7);
}

.fishing-dock-canvas__rear-wave {
  z-index: 3;
  top: calc(var(--dock-waterline-y, 328px) - 8px);
  opacity: 0.5;
  animation: fishing-dock-rear-wave 3.8s ease-in-out infinite alternate;
}

.fishing-dock-canvas__character {
  position: absolute;
  z-index: 5;
  top: var(--dock-boat-anchor-y, 351px);
  left: var(--dock-boat-anchor-x, 785px);
  width: var(--dock-character-width, 240px);
  height: auto;
  transform: translate(-50%, -94.27%) scaleX(-1);
  transform-origin: 50% 94.27%;
  filter: drop-shadow(0 9px 6px rgba(13, 51, 96, 0.22));
  animation: fishing-dock-character-bob 3.2s ease-in-out infinite;
}

.fishing-dock-canvas__front-wave {
  z-index: 6;
  top: calc(var(--dock-waterline-y, 328px) - 7px);
  height: 18px;
  background:
    radial-gradient(26px 10px at 50% 0, transparent 64%, rgba(221, 252, 255, 0.9) 68% 78%, transparent 83%) 0 0 / 52px 17px repeat-x;
  animation: fishing-dock-front-wave 3s ease-in-out infinite alternate;
}

.fishing-dock-canvas__fallback-guide {
  position: absolute;
  z-index: 7;
  top: var(--dock-hook-y, 278px);
  left: calc(var(--dock-hook-x, 640px) - 1px);
  width: 2px;
  height: calc(var(--dock-gauge-center-y, 421px) - var(--dock-gauge-size, 108px) * 0.46 - var(--dock-hook-y, 278px));
  border-radius: 999px;
  background: rgba(231, 251, 255, 0.76);
  box-shadow: 0 0 0 1px rgba(17, 93, 168, 0.12);
}

.fishing-dock-canvas__sparkles {
  position: absolute;
  z-index: 4;
  inset: 0;
}

.fishing-dock-canvas__sparkles span {
  position: absolute;
  width: 14px;
  height: 14px;
  color: #ffe42e;
  animation: fishing-dock-sparkle 2.2s ease-in-out infinite;
}

.fishing-dock-canvas__sparkles span::before,
.fishing-dock-canvas__sparkles span::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  height: 3px;
  border-radius: 2px;
  background: currentColor;
  content: "";
  transform: translate(-50%, -50%);
}

.fishing-dock-canvas__sparkles span::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.fishing-dock-canvas__sparkles span:nth-child(1) { top: 14%; left: 43%; }
.fishing-dock-canvas__sparkles span:nth-child(2) { top: 22%; left: 57%; animation-delay: -0.7s; }
.fishing-dock-canvas__sparkles span:nth-child(3) { top: 13%; left: 72%; animation-delay: -1.1s; }
.fishing-dock-canvas__sparkles span:nth-child(4) { top: 28%; left: 31%; animation-delay: -0.4s; }
.fishing-dock-canvas__sparkles span:nth-child(5) { top: 31%; left: 83%; animation-delay: -1.4s; }
.fishing-dock-canvas__sparkles span:nth-child(6) { top: 9%; left: 33%; animation-delay: -0.9s; }

.fishing-dock-canvas__fallback-gauge {
  position: absolute;
  z-index: 8;
  top: var(--dock-gauge-center-y, 421px);
  left: var(--dock-gameplay-axis-x, 640px);
  width: var(--dock-gauge-size, 108px);
  aspect-ratio: 1;
  transform: translate(-50%, -50%);
  filter: drop-shadow(0 6px 3px rgba(31, 34, 76, 0.28));
}

.fishing-dock-canvas__fallback-gauge > img:first-child {
  display: block;
  width: 100%;
  height: 100%;
}

.fishing-dock-canvas__fallback-pointer {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24%;
  height: auto;
  transform: translate(-10%, -50%) rotate(-76deg);
  transform-origin: 10% 50%;
  animation: fishing-dock-pointer 1.46s ease-in-out infinite alternate;
}

.fishing-dock-canvas__gauge-button {
  position: absolute;
  z-index: 15;
  top: var(--dock-gauge-center-y, 421px);
  left: var(--dock-gameplay-axis-x, 640px);
  width: var(--dock-gauge-size, 108px);
  aspect-ratio: 1;
  padding: 0;
  transform: translate(-50%, -50%);
  border: 0;
  border-radius: 50%;
  background: transparent;
  cursor: pointer;
  touch-action: manipulation;
}

.fishing-dock-canvas__gauge-button::before {
  position: absolute;
  inset: -6px;
  border: 2px solid rgba(255, 240, 82, 0.58);
  border-radius: inherit;
  box-shadow: 0 0 0 5px rgba(255, 213, 41, 0.08), 0 7px 18px rgba(33, 39, 86, 0.24);
  content: "";
  opacity: 0.72;
  transform: scale(0.98);
  transition: border-color 180ms ease, box-shadow 180ms ease, opacity 180ms ease, transform 120ms ease;
  animation: fishing-dock-gauge-pulse 2.6s ease-in-out infinite;
}

.fishing-dock-canvas__gauge-button:hover:not(:disabled)::before {
  border-color: rgba(255, 246, 128, 0.95);
  box-shadow: 0 0 0 7px rgba(255, 213, 41, 0.14), 0 9px 22px rgba(33, 39, 86, 0.3);
  opacity: 1;
  transform: scale(1.035);
}

.fishing-dock-canvas__gauge-button:active:not(:disabled)::before {
  transform: scale(0.96);
}

.fishing-dock-canvas__gauge-button:focus-visible {
  outline: 4px solid #fff159;
  outline-offset: 6px;
}

.fishing-dock-canvas__gauge-button:disabled {
  cursor: wait;
}

.fishing-dock-canvas__gauge-button:disabled::before {
  border-color: rgba(223, 234, 245, 0.46);
  box-shadow: none;
  opacity: 0.46;
  animation: none;
}

@keyframes fishing-dock-character-bob {
  0%, 100% { transform: translate(-50%, -94.27%) scaleX(-1) translateY(0) rotate(-0.45deg); }
  50% { transform: translate(-50%, -94.27%) scaleX(-1) translateY(2px) rotate(0.45deg); }
}

@keyframes fishing-dock-rear-wave {
  from { transform: translateX(-5px); }
  to { transform: translateX(5px); }
}

@keyframes fishing-dock-front-wave {
  from { transform: translateX(7px); }
  to { transform: translateX(-7px); }
}

@keyframes fishing-dock-sparkle {
  0%, 100% { opacity: 0.32; transform: scale(0.55) rotate(10deg); }
  50% { opacity: 0.9; transform: scale(0.95) rotate(45deg); }
}

@keyframes fishing-dock-pointer {
  from { transform: translate(-10%, -50%) rotate(-76deg); }
  to { transform: translate(-10%, -50%) rotate(104deg); }
}

@keyframes fishing-dock-gauge-pulse {
  0%, 100% { opacity: 0.55; transform: scale(0.98); }
  50% { opacity: 0.88; transform: scale(1.025); }
}

@media (prefers-reduced-motion: reduce) {
  .fishing-dock-canvas__fallback,
  .fishing-dock-canvas__character,
  .fishing-dock-canvas__rear-wave,
  .fishing-dock-canvas__front-wave,
  .fishing-dock-canvas__sparkles span,
  .fishing-dock-canvas__fallback-pointer,
  .fishing-dock-canvas__gauge-button::before {
    animation: none;
    transition: none;
  }
}
</file>

<file path="src/app/components/bat-ca/dock/fishing-dock.css">
.fishing-dock-hud {
  --dock-ink: #30274f;
  --dock-orange: #f45f18;
  --dock-orange-edge: #c94410;
  --dock-yellow: #ffd529;
  --dock-white: #fffefe;
  --dock-blue: #176be7;
  --dock-muted: #716a8a;
  --dock-shadow: rgba(35, 48, 103, 0.28);

  position: absolute;
  inset: 0;
  z-index: 20;
  overflow: hidden;
  color: var(--dock-ink);
  font-family: "Be Vietnam Pro", system-ui, sans-serif;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
  pointer-events: none;
  user-select: none;
  -webkit-user-select: none;
}

.fishing-dock-hud,
.fishing-dock-hud * {
  box-sizing: border-box;
}

.fishing-dock-hud button {
  margin: 0;
  color: inherit;
  font: inherit;
  letter-spacing: 0;
  -webkit-tap-highlight-color: transparent;
}

.fishing-dock-hud__pressable {
  pointer-events: auto;
  touch-action: manipulation;
  transition: filter 180ms ease, box-shadow 180ms ease, opacity 180ms ease, transform 100ms ease;
}

.fishing-dock-hud__pressable:focus-visible {
  outline: 4px solid #fff159;
  outline-offset: 3px;
}

.fishing-dock-hud__pressable:active:not(:disabled) {
  transform: translateY(2px) scale(0.98);
}

.fishing-dock-hud__pressable:disabled {
  cursor: not-allowed;
}

.fishing-dock-hud.is-locked .fishing-dock-hud__pressable {
  pointer-events: none;
}

.fishing-dock-hud__settings,
.fishing-dock-hud__rail {
  left: var(--dock-safe-left, 20px);
}

.fishing-dock-hud__settings {
  position: absolute;
  top: var(--dock-safe-top, 25px);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  padding: 0;
  border: 3px solid #ffffff;
  border-radius: 16px;
  background: #ffffff;
  box-shadow: 0 5px 0 var(--dock-shadow), 0 10px 24px rgba(36, 55, 112, 0.16);
  cursor: pointer;
}

.fishing-dock-hud__settings svg {
  width: 26px;
  height: 26px;
  stroke-width: 2.8;
  color: var(--dock-blue);
}

.fishing-dock-hud__earnings {
  position: absolute;
  top: var(--dock-safe-top, 25px);
  left: var(--dock-gameplay-axis-x, 640px);
  display: flex;
  width: min(26vw, 280px);
  min-width: 140px;
  transform: translateX(-50%);
  flex-direction: column;
  align-items: center;
  gap: 2px;
  text-align: center;
  line-height: 1;
}

.fishing-dock-hud__eyebrow {
  color: #ffffff;
  background: #e95016;
  padding: 3px 10px;
  border-radius: 10px;
  border: 2px solid #ffffff;
  box-shadow: 0 3px 0 var(--dock-shadow);
  font-size: clamp(10px, 0.82vw, 12px);
  font-weight: 900;
  line-height: 1.1;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 2px;
}

.fishing-dock-hud__earnings-value {
  max-width: 360px;
  overflow: hidden;
  color: var(--dock-white);
  font-size: clamp(32px, 3.35vw, 48px);
  font-weight: 1000;
  line-height: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow:
    -2px -2px 0 var(--dock-ink),
    2px -2px 0 var(--dock-ink),
    -2px 2px 0 var(--dock-ink),
    2px 2px 0 var(--dock-ink),
    0 4px 0 rgba(48, 39, 79, 0.34);
}

.fishing-dock-hud__best {
  position: absolute;
  top: var(--dock-safe-top, 25px);
  right: var(--dock-safe-right, 20px);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border: 3px solid #ffffff;
  border-radius: 18px;
  background: #ffffff;
  box-shadow: 0 5px 0 var(--dock-shadow), 0 10px 24px rgba(36, 55, 112, 0.16);
  line-height: 1;
  white-space: nowrap;
}

.fishing-dock-hud__best > svg {
  width: 24px;
  height: 24px;
  color: #ecb800;
  flex: 0 0 auto;
  filter: drop-shadow(0 2px 0 rgba(137, 80, 0, 0.25));
}

.fishing-dock-hud__best strong {
  font-size: clamp(16px, 1.4vw, 20px);
  font-weight: 1000;
  color: var(--dock-ink);
}

.fishing-dock-hud__best-badge {
  position: absolute;
  top: -8px;
  right: 12px;
  padding: 1px 6px;
  border-radius: 6px;
  background: #ff6b00;
  color: #ffffff;
  font-size: 9px;
