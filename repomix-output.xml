import { BOTTOM_Y, DEPTH_UPGRADE_DELTA } from "./constants";
import { UPGRADE_META } from "./fish-data";
import type { PlayerStats, UpgradeType } from "./types";

export type UpgradeDef = {
  type: UpgradeType;
  name: string;
  desc: string;
  maxLevel: number;
  costs: number[];
  apply: (stats: PlayerStats) => void;
};

export const UPGRADE_DEFS: UpgradeDef[] = [
  {
    type: "depth",
    name: UPGRADE_META.depth.name,
    desc: UPGRADE_META.depth.desc,
    maxLevel: UPGRADE_META.depth.maxLevel,
    costs: [...UPGRADE_META.depth.costs],
    apply: (s) => { s.maxDepth = Math.min(BOTTOM_Y - 10, s.maxDepth + DEPTH_UPGRADE_DELTA); },
  },
  {
    type: "netSize",
    name: UPGRADE_META.netSize.name,
    desc: UPGRADE_META.netSize.desc,
    maxLevel: UPGRADE_META.netSize.maxLevel,
    costs: [...UPGRADE_META.netSize.costs],
    apply: (s) => { s.netSize += 6; },
  },
  {
    type: "pullSpeed",
    name: UPGRADE_META.pullSpeed.name,
    desc: UPGRADE_META.pullSpeed.desc,
    maxLevel: UPGRADE_META.pullSpeed.maxLevel,
    costs: [...UPGRADE_META.pullSpeed.costs],
    apply: (s) => { s.pullSpeed += 45; },
  },
  {
    type: "capacity",
    name: UPGRADE_META.capacity.name,
    desc: UPGRADE_META.capacity.desc,
    maxLevel: UPGRADE_META.capacity.maxLevel,
    costs: [...UPGRADE_META.capacity.costs],
    apply: (s) => { s.capacity += 1; },
  },
];

export function upgradeCost(def: UpgradeDef, currentLevel: number): number | null {
  if (currentLevel >= def.maxLevel) return null;
  return def.costs[currentLevel];
}
</file>

<file path="app/components/bat-ca/hooks/useBatCaGame.ts">
import { useCallback, useRef, useState } from "react";
import { Game, type GameMode, type HudSnapshot, type CaughtSummary } from "../engine";

export function useBatCaGame() {
  const gameRef = useRef<Game | null>(null);
  if (!gameRef.current) gameRef.current = new Game();
  const game = gameRef.current;

  const [mode, setMode] = useState<GameMode>("start");
  const [hud, setHud] = useState<HudSnapshot>(() => game.hud());
  const [summary, setSummary] = useState<CaughtSummary | null>(null);
  const [, force] = useState(0);

  const refresh = useCallback(() => {
    setHud(game.hud());
    force((n) => n + 1);
  }, [game]);

  const onSell = useCallback((s: CaughtSummary) => {
    setSummary(s);
    setMode("result");
    setHud(game.hud());
    try {
      localStorage.setItem("batca-last-score", String(s.earned));
    } catch {
      // ignore
    }
  }, [game]);

  game.onSell = onSell;

  const onHud = useCallback((h: HudSnapshot) => setHud(h), []);
  const play = useCallback(() => { game.mode = "playing"; setMode("playing"); }, [game]);
  const continuePlay = useCallback(() => { game.mode = "playing"; setMode("playing"); }, [game]);
  const openUpgrade = useCallback(() => { game.mode = "upgrade"; setMode("upgrade"); setHud(game.hud()); }, [game]);
  const closeUpgrade = useCallback(() => { game.mode = "playing"; setMode("playing"); }, [game]);

  return {
    game,
    mode,
    hud,
    summary,
    refresh,
    onHud,
    play,
    continuePlay,
    openUpgrade,
    closeUpgrade,
  };
}
</file>

