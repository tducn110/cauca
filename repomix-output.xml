    border: "1.5px solid rgba(138,125,101,0.25)",
    borderRadius: 16,
    padding: "12px 14px",
    display: "flex",
    flexDirection: "column",
    alignItems: "flex-start",
    boxShadow: "0 4px 12px rgba(42,36,24,0.04)",
  };
}

function statLabelStyle(): React.CSSProperties {
